# Lombok is used only for boilerplate that records can't replace:
# @RequiredArgsConstructor (constructor injection), @Builder, @Getter, @Slf4j.
# See docs/standards/backend.md.
config.stopBubbling = true

# Mark generated code so coverage tools (JaCoCo) ignore it.
lombok.addLombokGeneratedAnnotation = true

# Banned: @Data and @EqualsAndHashCode generate equals/hashCode from all fields, which is wrong
# for JPA entities (lazy proxies, ids assigned on persist). Entities define equals/hashCode by hand.
lombok.data.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error

# Banned: @Value. Use a record instead.
lombok.value.flagUsage = error
