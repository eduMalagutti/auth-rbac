# Editor defaults, aligned with the Spotless rules in style/spotless.gradle.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,toml,md}]
indent_size = 2

[*.gradle]
indent_style = tab

[*.bat]
end_of_line = crlf
